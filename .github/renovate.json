{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":timezone(UTC)"
  ],
  "schedule": [
    "every weekend"
  ],
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "commitMessagePrefix": "build(deps):",
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_version"
      ],
      "overridePackageName": "opentofu/opentofu",
      "overrideDepName": "opentofu/opentofu"
    },
    {
      "description": "Flux tracks app charts; chart digest pins hold intentional rollbacks.",
      "matchPackageNames": [
        "ghcr.io/itay-raveh/charts/wanderbound",
        "ghcr.io/itay-raveh/charts/quizmon"
      ],
      "enabled": false
    }
  ]
}
